+#    define _LIBCPP_TYPE_VIS _LIBCPP_DLL_VIS
+#    define _LIBCPP_FUNC_VIS _LIBCPP_DLL_VIS
+#    define _LIBCPP_EXCEPTION_ABI _LIBCPP_DLL_VIS
