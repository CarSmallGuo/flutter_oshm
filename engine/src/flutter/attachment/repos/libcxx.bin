diff --git a/include_old/cstdbool b/include_old/cstdbool
new file mode 100644
index 000000000..ce608033a
--- /dev/null
+++ b/include_old/cstdbool
@@ -0,0 +1,32 @@
+// -*- C++ -*-
+//===----------------------------------------------------------------------===//
+//
