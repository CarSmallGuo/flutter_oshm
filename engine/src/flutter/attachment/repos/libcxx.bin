diff --git a/include_old/__type_traits/is_aggregate.h b/include_old/__type_traits/is_aggregate.h
new file mode 100644
index 000000000..ea9de84f9
--- /dev/null
+++ b/include_old/__type_traits/is_aggregate.h
@@ -0,0 +1,33 @@
