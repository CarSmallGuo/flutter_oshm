+  struct _fpstate fpstate;
+  struct _header xstate_hdr;
+  struct _ymmh_state ymmh;
+};
+struct sigcontext_32 {
+  __u16 gs, __gsh;
+  __u16 fs, __fsh;
+  __u16 es, __esh;
+  __u16 ds, __dsh;
+  __u32 di;
+  __u32 si;
+  __u32 bp;
+  __u32 sp;
