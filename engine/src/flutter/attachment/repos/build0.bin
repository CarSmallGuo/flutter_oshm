+#include <linux/netlink.h>
+struct net_dm_drop_point {
+  __u8 pc[8];
+  __u32 count;
+};
+#define is_drop_point_hw(x) do { int ____i, ____j; for(____i = 0; ____i < 8; i ____i ++) ____j |= x[____i]; ____j; \
+} while(0)
+#define NET_DM_CFG_VERSION 0
