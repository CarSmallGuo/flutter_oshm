+  unsigned short sas_family;
+  struct {
+    unsigned char prv[ATM_ESA_LEN];
+    char pub[ATM_E164_LEN + 1];
+    char lij_type;
+    __u32 lij_id;
+  } sas_addr __ATM_API_ALIGN;
+};
+struct atmif_sioc {
+  int number;
+  int length;
+  void __user * arg;
+};
+typedef unsigned short atm_backend_t;
