+  __u32 rq_page_size;
+  __u32 num_sq_pages;
+  __u32 num_rq_pages;
+  __aligned_u64 sq_page_addr[MAX_QP_PAGES];
+  __aligned_u64 rq_page_addr[MAX_QP_PAGES];
