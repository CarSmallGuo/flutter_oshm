+#define XFRM_MSG_GETSADINFO XFRM_MSG_GETSADINFO
+  XFRM_MSG_NEWSPDINFO,
+#define XFRM_MSG_NEWSPDINFO XFRM_MSG_NEWSPDINFO
+  XFRM_MSG_GETSPDINFO,
