+  struct ip_set_counter_match0 bytes;
+  __u32 flags;
+};
+struct xt_set_info_target_v3 {
+  struct xt_set_info add_set;
+  struct xt_set_info del_set;
+  struct xt_set_info map_set;
+  __u32 flags;
+  __u32 timeout;
+};
+struct xt_set_info_match_v4 {
