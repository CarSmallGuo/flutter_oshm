+  unsigned long st_size;
+  unsigned long st_atime;
+  unsigned long st_mtime;
+  unsigned long st_ctime;
+#else
+  unsigned int st_size;
+  unsigned int st_atime;
+  unsigned int st_mtime;
+  unsigned int st_ctime;
+#endif
+};
