+#define IPMICTL_SEND_COMMAND_SETTIME _IOR(IPMI_IOC_MAGIC, 21, struct ipmi_req_settime)
+struct ipmi_recv {
+  int recv_type;
+  unsigned char __user * addr;
+  unsigned int addr_len;
+  long msgid;
