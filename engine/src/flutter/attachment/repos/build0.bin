+  unsigned int data_size;
+};
+struct i2o_evt_get {
+  struct i2o_evt_info info;
+  int pending;
+  int lost;
+};
+typedef struct i2o_sg_io_hdr {
+  unsigned int flags;
+} i2o_sg_io_hdr_t;
+#define I2O_BUS_LOCAL 0
+#define I2O_BUS_ISA 1
+#define I2O_BUS_EISA 2
+#define I2O_BUS_PCI 4
+#define I2O_BUS_PCMCIA 5
