+int get_device_api_version(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // _INFO_DEVICE_API_VERSION_H
diff --git a/build/ohos/ohos-sysroot/usr/include/info/fatal_message.h b/build/ohos/ohos-sysroot/usr/include/info/fatal_message.h
