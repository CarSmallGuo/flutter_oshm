+};
+struct drm_buf_free {
+  int count;
+  int __user * list;
+};
+struct drm_buf_pub {
+  int idx;
+  int total;
+  int used;
+  void __user * address;
+};
+struct drm_buf_map {
+  int count;
+#ifdef __cplusplus
+  void __user * virt;
+#else
+  void __user * __linux_virtual;
+#endif
