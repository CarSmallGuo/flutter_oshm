+  ETH_SS_PRIV_FLAGS,
+  ETH_SS_NTUPLE_FILTERS,
+  ETH_SS_FEATURES,
+  ETH_SS_RSS_HASH_FUNCS,
+  ETH_SS_TUNABLES,
+  ETH_SS_PHY_STATS,
+  ETH_SS_PHY_TUNABLES,
