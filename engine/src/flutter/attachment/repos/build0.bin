+#define EVIOCSMASK _IOW('E', 0x93, struct input_mask)
+#define EVIOCSCLOCKID _IOW('E', 0xa0, int)
+#define ID_BUS 0
+#define ID_VENDOR 1
+#define ID_PRODUCT 2
+#define ID_VERSION 3
+#define BUS_PCI 0x01
