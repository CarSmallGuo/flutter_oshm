+#define C_FL_IXX 0x00000002
+#define C_FL_OIXANY 0x00000004
+#define C_FL_SWFLOW 0x0000000f
+#define C_FS_TXIDLE 0x00000000
+#define C_FS_SENDING 0x00000001
+#define C_FS_SWFLOW 0x00000002
