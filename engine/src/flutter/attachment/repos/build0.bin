+  int delta_sx, delta_sy;
+  int delta_dx, delta_dy;
+  int height, ydir;
+  int source_pitch, dest_pitch;
+} drm_mga_blit_t;
+#define MGA_PARAM_IRQ_NR 1
+#define MGA_PARAM_CARD_TYPE 2
+typedef struct drm_mga_getparam {
+  int param;
