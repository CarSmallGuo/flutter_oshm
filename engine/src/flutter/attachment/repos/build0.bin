+  lwc1_op,
+  lwc2_op,
+  bc6_op = lwc2_op,
+  pref_op,
+  lld_op,
+  ldc1_op,
+  ldc2_op,
+  pop66_op = ldc2_op,
+  ld_op,
+  sc_op,
+  swc1_op,
+  swc2_op,
+  balc6_op = swc2_op,
+  major_3b_op,
+  scd_op,
+  sdc1_op,
+  sdc2_op,
+  pop76_op = sdc2_op,
+  sd_op
+};
+enum spec_op {
+  sll_op,
+  movc_op,
+  srl_op,
+  sra_op,
