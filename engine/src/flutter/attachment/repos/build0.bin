+  struct fs_qfilestatv qs_pquota;
+  __s32 qs_btimelimit;
+  __s32 qs_itimelimit;
+  __s32 qs_rtbtimelimit;
+  __u16 qs_bwarnlimit;
+  __u16 qs_iwarnlimit;
+  __u64 qs_pad2[8];
+};
+#endif
