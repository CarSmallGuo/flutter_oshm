+ ***
+ ****************************************************************************
+ ****************************************************************************/
+#ifndef __SOUND_HDSPM_H
+#define __SOUND_HDSPM_H
+#ifdef __linux__
+#include <linux/types.h>
+#endif
+#define HDSPM_MAX_CHANNELS 64
+enum hdspm_io_type {
+  MADI,
+  MADIface,
+  AIO,
+  AES32,
+  RayDAT
+};
