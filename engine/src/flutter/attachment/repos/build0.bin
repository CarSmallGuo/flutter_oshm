+    struct mei_client out_client_properties;
+  };
+};
+#define IOCTL_MEI_NOTIFY_SET _IOW('H', 0x02, __u32)
+#define IOCTL_MEI_NOTIFY_GET _IOR('H', 0x03, __u32)
+struct mei_connect_client_vtag {
