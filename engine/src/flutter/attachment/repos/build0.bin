+  syncsource_tco = 2,
+  syncsource_sync = 3,
+  syncsource_none = 4
+};
+struct hdspm_status {
+  __u8 card_type;
+  enum hdspm_syncsource autosync_source;
+  __u64 card_clock;
+  __u32 master_period;
