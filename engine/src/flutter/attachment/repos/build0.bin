+  union {
+    struct {
+      __u32 major;
+      __u32 minor;
+    } dev;
+    struct {
+      __u32 card;
+      __u32 device;
+      __u32 subdevice;
+    } alsa;
+    struct {
+      __u32 major;
+      __u32 minor;
+    } v4l;
+    struct {
