+};
+#define XFRM_MSG_MAX (__XFRM_MSG_MAX - 1)
+#define XFRM_NR_MSGTYPES (XFRM_MSG_MAX + 1 - XFRM_MSG_BASE)
+struct xfrm_user_sec_ctx {
+  __u16 len;
+  __u16 exttype;
+  __u8 ctx_alg;
+  __u8 ctx_doi;
+  __u16 ctx_len;
+};
