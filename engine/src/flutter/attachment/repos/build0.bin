+#define I2O_BUS_CARDBUS 7
+#define I2O_BUS_UNKNOWN 0x80
+typedef struct _i2o_pci_bus {
+  __u8 PciFunctionNumber;
+  __u8 PciDeviceNumber;
+  __u8 PciBusNumber;
