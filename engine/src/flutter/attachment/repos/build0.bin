+typedef struct in_ctrl_info {
+  __u8 Last_NHRP_CIE_code;
+  __u8 Last_Q2931_cause_value;
+  __u8 eg_MPC_ATM_addr[ATM_ESA_LEN];
+  __be32 tag;
+  __be32 in_dst_ip;
+  __u16 holding_time;
+  __u32 request_id;
+} in_ctrl_info;
+typedef struct eg_ctrl_info {
+  __u8 DLL_header[256];
+  __u8 DH_length;
+  __be32 cache_id;
+  __be32 tag;
+  __be32 mps_ip;
+  __be32 eg_dst_ip;
