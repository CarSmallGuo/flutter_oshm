+  msa_op = mdmx_op,
+  spec3_op,
+  lb_op,
+  lh_op,
+  lwl_op,
+  lw_op,
+  lbu_op,
+  lhu_op,
+  lwr_op,
+  lwu_op,
+  sb_op,
+  sh_op,
+  swl_op,
+  sw_op,
+  sdl_op,
+  sdr_op,
+  swr_op,
+  cache_op,
