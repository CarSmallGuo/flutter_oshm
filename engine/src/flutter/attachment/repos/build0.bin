+struct sockaddr_dn {
+  __u16 sdn_family;
+  __u8 sdn_flags;
+  __u8 sdn_objnum;
+  __le16 sdn_objnamel;
+  __u8 sdn_objname[DN_MAXOBJL];
+  struct dn_naddr sdn_add;
+};
+#define sdn_nodeaddrl sdn_add.a_len
+#define sdn_nodeaddr sdn_add.a_addr
+struct optdata_dn {
