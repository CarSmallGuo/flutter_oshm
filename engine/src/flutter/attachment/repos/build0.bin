+  int __user * send_sizes;
+  enum drm_dma_flags flags;
+  int request_count;
+  int request_size;
+  int __user * request_indices;
+  int __user * request_sizes;
+  int granted_count;
+};
+enum drm_ctx_flags {
+  _DRM_CONTEXT_PRESERVED = 0x01,
+  _DRM_CONTEXT_2DONLY = 0x02
+};
